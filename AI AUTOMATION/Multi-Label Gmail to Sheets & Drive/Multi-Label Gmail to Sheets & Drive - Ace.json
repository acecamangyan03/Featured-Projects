{
  "name": "Multi-Label Gmail to Sheets & Drive",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "b6767541-f960-4fbb-b765-a860c6db52e1",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-928, 1008]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "labelMapJson",
              "type": "string",
              "value": "={\"YOUR_GMAIL_LABEL_ID\":\"Invoices\"}"
            },
            {
              "id": "c2",
              "name": "gmailQuery",
              "type": "string",
              "value": "=(label:Invoices) is:unread"
            },
            {
              "id": "c3",
              "name": "sheetDocumentId",
              "type": "string",
              "value": "YOUR_GOOGLE_SHEET_ID"
            },
            {
              "id": "c4",
              "name": "sheetName",
              "type": "string",
              "value": "Sheet1"
            },
            {
              "id": "c5",
              "name": "driveRootFolderId",
              "type": "string",
              "value": "YOUR_DRIVE_ROOT_FOLDER_ID"
            }
          ]
        },
        "options": {}
      },
      "id": "acf3d3e7-1e90-4e80-abd6-f1d575d67f41",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-704, 1008],
      "notes": "Edit labelMapJson to match your real Gmail label IDs -> friendly names, edit gmailQuery to match, and fill in the Sheet ID / Drive root folder ID."
    },
    {
      "parameters": {
        "operation": "getAll",
        "returnAll": true,
        "simple": false,
        "filters": {
          "q": "={{ $json.gmailQuery }}"
        },
        "options": {
          "downloadAttachments": true
        }
      },
      "id": "04e9b28a-92b3-4c24-a08a-7beb9bc32c8e",
      "name": "Get Labeled Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [-480, 1008]
    },
    {
      "parameters": {
        "jsCode": "const labelMap = JSON.parse($('Config').first().json.labelMapJson);\nconst results = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n\n  const fromEntry = (j.from && j.from.value && j.from.value[0]) || {};\n  const senderName = fromEntry.name || fromEntry.address || 'Unknown Sender';\n  const senderEmail = fromEntry.address || '';\n\n  const dateObj = j.date ? new Date(j.date) : new Date();\n  const dateReceived = isNaN(dateObj.getTime())\n    ? new Date().toISOString().slice(0, 10)\n    : dateObj.toISOString().slice(0, 10);\n\n  const matchedLabelId = (j.labelIds || []).find(id => labelMap[id]);\n  const label = matchedLabelId ? labelMap[matchedLabelId] : 'unlabeled';\n\n  results.push({\n    json: {\n      messageId: j.id,\n      senderName,\n      senderEmail,\n      subject: j.subject || '(no subject)',\n      dateReceived,\n      label,\n      attachmentCount: Object.keys(item.binary || {}).length\n    },\n    binary: item.binary || {}\n  });\n}\n\nreturn results;"
      },
      "id": "e9450def-e0d0-4916-923e-3753ffdc194c",
      "name": "Extract Sender Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-256, 1008]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "mode": "id",
          "value": "={{ $('Config').first().json.sheetDocumentId }}"
        },
        "sheetName": {
          "mode": "name",
          "value": "={{ $('Config').first().json.sheetName }}"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "f103a15b-8ce5-4110-933c-c775c14c7e04",
      "name": "Log to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-48, 1008]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.attachmentCount }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4a05ae14-8642-457a-900a-08cd03c4162f",
      "name": "Has Attachments?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [192, 1008]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const binaryKeys = Object.keys(item.binary || {});\n  for (const key of binaryKeys) {\n    out.push({\n      json: { ...item.json, binaryKey: key, fileName: item.binary[key].fileName },\n      binary: { data: item.binary[key] }\n    });\n  }\n}\nreturn out;"
      },
      "id": "426751a4-d1d6-41e0-903f-b1a10c67e645",
      "name": "One Item Per Attachment",
      "type": "n8n-nodes-base.code",
